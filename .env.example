# Manager Warsztatów — environment configuration.
# Copy to `.env` and adjust. Variables already set in the environment win over this file.

# --- Core --------------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
# The public address, without a trailing slash. Its host is always allowed.
SITE_URL=http://localhost:8000
# Extra host names (comma-separated), e.g. an internal address used by monitoring.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# true on TEST servers: search engines are told not to index anything.
SITE_NOINDEX=false
TIME_ZONE=Europe/Warsaw

# --- First administrator ---------------------------------------------------------------------
# Created on start if missing; signs in with a one-time code sent to this address.
ADMIN_EMAIL=

# --- Data --------------------------------------------------------------------------------------
# Where the SQLite database and uploads live (the `data` volume in containers).
# DATA_DIR=./data
# DATABASE_URL=sqlite:////data/db.sqlite3

# --- Email -------------------------------------------------------------------------------------
# Fallback transport; SMTP settings saved in the admin panel take precedence.
# Examples: consolemail://   smtp+tls://user:password@smtp.example.com:587   smtp://mailpit:1025
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Manager Warsztatów <noreply@localhost>

# --- Sessions ----------------------------------------------------------------------------------
# How long "Zapamiętaj mnie" keeps a device signed in (days since the last visit).
SESSION_REMEMBER_DAYS=180

# --- Reverse proxy and security (servers) --------------------------------------------------------
# Set by compose.prod.yaml; the edge passes the visitor's address in X-Real-IP.
# TRUST_PROXY_HEADERS=true
# CLIENT_IP_HEADER=X-Real-IP
# CSP_ENFORCE=true
# SECURE_HSTS_SECONDS=3600

# --- Background tasks --------------------------------------------------------------------------
TASK_WORKERS=1
LOG_LEVEL=INFO

# --- Servers only --------------------------------------------------------------------------------
# TEST: COMPOSE_FILE=compose.yaml:compose.prod.yaml
# PROD: COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.npm.yaml
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
# Image tag: dev on TEST, X.Y.Z on PROD.
# APP_TAG=dev
# TEST: publish the edge on the LAN for the Cloudflare tunnel.
# EDGE_BIND=0.0.0.0
# EDGE_PORT=80
